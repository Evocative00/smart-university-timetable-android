<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/smart_auth_screen_padding"
        android:paddingTop="@dimen/smart_signup_top_padding"
        android:paddingEnd="@dimen/smart_auth_screen_padding"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/smart_back_button_size"
                android:layout_height="@dimen/smart_back_button_size"
                android:layout_gravity="start|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_back_description"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/smart_text_secondary" />

            <ImageView
                android:layout_width="@dimen/smart_signup_logo_size"
                android:layout_height="@dimen/smart_signup_logo_size"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="@string/content_app_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_characters" />
        </FrameLayout>

        <TextView
            style="@style/Text.SmartTimetable.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/signup_title" />

        <TextView
            style="@style/Text.SmartTimetable.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/signup_desc" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_auth_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_auth_card_padding">

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_input_height"
                    android:autofillHints="name"
                    android:background="@drawable/bg_smart_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_name"
                    android:includeFontPadding="false"
                    android:inputType="textPersonName"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/smart_text_primary"
                    android:textColorHint="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_input_height"
                    android:layout_marginTop="14dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_smart_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_email"
                    android:includeFontPadding="false"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/smart_text_primary"
                    android:textColorHint="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_input_height"
                    android:layout_marginTop="14dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_smart_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_password"
                    android:includeFontPadding="false"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/smart_text_primary"
                    android:textColorHint="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignup"
                    style="@style/Widget.SmartTimetable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_button_height"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_signup"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLoginPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="@string/signup_login_prompt"
                    android:textColor="@color/smart_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
