<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_user_search_input"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/smart_text_primary"
        android:textColorHint="@color/smart_text_muted"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/lv_lectures"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_user_search_list"
        android:cacheColorHint="@android:color/transparent"
        android:choiceMode="singleChoice"
        android:clipToPadding="false"
        android:divider="@color/smart_border"
        android:dividerHeight="1dp"
        android:fadingEdge="none"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
