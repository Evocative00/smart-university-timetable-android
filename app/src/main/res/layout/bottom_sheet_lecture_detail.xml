<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_recommendation_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_recommendation_drag_handle" />

    <TextView
        android:id="@+id/tv_detail_course_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="강의명"
        android:textColor="@color/smart_text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_detail_professor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="교수명"
        android:textColor="@color/smart_primary_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_detail_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_recommendation_picker_item"
        android:padding="16dp"
        android:text="3학점 · 과목코드 · 강의실"
        android:textColor="@color/smart_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_detail_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_recommendation_picker_item"
        android:padding="16dp"
        android:text="월 09:00~10:30"
        android:textColor="@color/smart_text_primary"
        android:textSize="14sp" />
</LinearLayout>
