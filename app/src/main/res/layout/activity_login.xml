<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/smart_auth_screen_padding"
        android:paddingTop="@dimen/smart_login_top_padding"
        android:paddingEnd="@dimen/smart_auth_screen_padding"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:contentDescription="@string/content_app_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_characters" />

        <TextView
            style="@style/Text.SmartTimetable.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/login_title" />

        <TextView
            style="@style/Text.SmartTimetable.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/login_desc" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_auth_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_auth_card_padding">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_input_height"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_smart_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_email"
                    android:includeFontPadding="false"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/smart_text_primary"
                    android:textColorHint="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_input_height"
                    android:layout_marginTop="14dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_smart_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_password"
                    android:includeFontPadding="false"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/smart_text_primary"
                    android:textColorHint="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.SmartTimetable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_button_height"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_login"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoveSignup"
                    style="@style/Widget.SmartTimetable.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_auth_button_height"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_move_signup"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_smart_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/login_feature_ai"
                android:textColor="@color/smart_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_smart_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/login_feature_grade"
                android:textColor="@color/smart_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_smart_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/login_feature_manage"
                android:textColor="@color/smart_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
