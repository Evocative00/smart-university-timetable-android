<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smart_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/smart_primary"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="뒤로가기"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hard_title"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hard_desc"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_credits"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="dropdown_menu">

                    <AutoCompleteTextView
                        android:id="@+id/auto_credits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:contentDescription="@string/hint_credits"
                        android:hint="@string/hint_credits"
                        android:inputType="none"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/hint_category"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="dropdown_menu">

                    <AutoCompleteTextView
                        android:id="@+id/auto_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:contentDescription="@string/hint_category"
                        android:hint="@string/hint_category"
                        android:inputType="none"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/hint_lecture"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="none">

                    <AutoCompleteTextView
                        android:id="@+id/auto_lecture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:contentDescription="@string/hint_lecture"
                        android:hint="@string/hint_lecture"
                        android:inputType="none"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_lecture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_add_fixed_lecture"
                    app:cornerRadius="18dp" />

                <TextView
                    android:id="@+id/tv_selected_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/selected_fixed_lectures_title"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_selected_lectures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_selected_box"
                    android:minHeight="72dp"
                    android:padding="14dp"
                    android:text="@string/selected_fixed_lectures_empty"
                    android:textColor="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_excluded_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="이미 이수했거나 추천에서 제외할 과목"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="전공 과목은 학년별 버튼에서 선택하고, 교양은 과목명을 직접 입력하세요."
                    android:textColor="@color/smart_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layout_excluded_grade_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1학년"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="2학년"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_3"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="3학년"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_4"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="4학년"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_excluded_major_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tv_selected_excluded_lectures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_selected_box"
                    android:minHeight="64dp"
                    android:padding="14dp"
                    android:text="선택된 이수/제외 과목 없음"
                    android:textColor="@color/smart_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_excluded_general_category_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="교양 영역별 제외 과목"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 필수교양 버튼은 항상 보이도록, 영역별 교양 버튼과 같은 행에 배치합니다 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_required_general"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="필수교양"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_general_group"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="영역별 교양"
                        android:textSize="14sp"
                        app:cornerRadius="14dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_general_area_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="8dp">

                    <CheckBox
                        android:id="@+id/cb_excluded_humanities_art"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="인문예술 영역 제외"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cb_excluded_natural_science"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="자연과학 영역 제외"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cb_excluded_social_science"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="사회과학 영역 제외"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cb_excluded_digital_literacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="디지털 영역 제외"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cb_excluded_character"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="인성교육 영역 제외"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_excluded_general_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_optional"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="일반선택"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_all_current_category"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="현재 카테고리 전체 선택"
                    app:cornerRadius="18dp" />

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:text="하드 제약 초기화"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/btn_next"
                    app:cornerRadius="18dp" />



            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>