<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/smart_main_screen_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/smart_main_screen_padding"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/smart_back_button_size"
            android:layout_height="@dimen/smart_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_description"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/smart_text_primary" />

        <TextView
            style="@style/Text.SmartTimetable.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/hard_title" />

        <TextView
            style="@style/Text.SmartTimetable.ScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/hard_desc" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hard_basic_condition_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/hard_basic_condition_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.SmartTimetable.TextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_credits"
                        app:endIconMode="dropdown_menu">

                        <AutoCompleteTextView
                            android:id="@+id/auto_credits"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/hint_credits"
                            android:inputType="none"
                            android:minHeight="46dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.SmartTimetable.TextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_category"
                        app:endIconMode="dropdown_menu">

                        <AutoCompleteTextView
                            android:id="@+id/auto_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/hint_category"
                            android:inputType="none"
                            android:minHeight="46dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    android:id="@+id/tv_selected_title"
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/selected_fixed_lectures_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/hard_fixed_lecture_desc" />

                <TextView
                    android:id="@+id/tv_selected_lectures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_smart_empty_state"
                    android:minHeight="42dp"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/selected_fixed_lectures_empty"
                    android:textColor="@color/smart_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_lecture"
                    style="@style/Widget.SmartTimetable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_add_fixed_lecture" />

                <AutoCompleteTextView
                    android:id="@+id/auto_lecture"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    android:id="@+id/tv_excluded_title"
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hard_excluded_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/hard_excluded_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_selected_excluded_lectures"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_summary_pill"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="이수/제외 0개"
                        android:textColor="@color/smart_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_selected_general_area_summary"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_summary_pill"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="교양 영역 0개"
                        android:textColor="@color/smart_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_excluded_lectures"
                    style="@style/Widget.SmartTimetable.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_manage_excluded_lectures"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/layout_excluded_manage_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:id="@+id/tv_excluded_general_category_title"
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/hard_excluded_manage_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/hard_excluded_manage_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_required_general"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="필수교양"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_general_group"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:text="영역별 교양"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_optional"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:text="일반선택"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_excluded_general_row_3"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_general_area_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cb_excluded_humanities_art"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="인문예술 영역 제외"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cb_excluded_natural_science"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checkable="true"
                        android:text="자연과학 영역 제외"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cb_excluded_social_science"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checkable="true"
                        android:text="사회과학 영역 제외"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cb_excluded_digital_literacy"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checkable="true"
                        android:text="디지털 리터러시 영역 제외"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cb_excluded_character"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checkable="true"
                        android:text="인성교육 영역 제외"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_excluded_grade_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_1"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="1학년"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_2"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="2학년"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_3"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="3학년"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_excluded_grade_4"
                        style="@style/Widget.SmartTimetable.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="4학년"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_all_current_category"
                    style="@style/Widget.SmartTimetable.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:text="현재 카테고리 전체 선택"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_excluded_major_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/Widget.SmartTimetable.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="초기화" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/Widget.SmartTimetable.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/btn_next" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
