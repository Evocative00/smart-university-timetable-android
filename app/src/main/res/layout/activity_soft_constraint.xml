<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/smart_primary"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/smart_primary_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="18dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_back_description"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/soft_title"
                    android:textColor="@color/white"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/soft_desc"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soft_free_day_title"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkboxMonday"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/day_monday"
                        android:textColor="@color/smart_text_primary" />

                    <CheckBox
                        android:id="@+id/checkboxTuesday"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/day_tuesday"
                        android:textColor="@color/smart_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkboxWednesday"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/day_wednesday"
                        android:textColor="@color/smart_text_primary" />

                    <CheckBox
                        android:id="@+id/checkboxThursday"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/day_thursday"
                        android:textColor="@color/smart_text_primary" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkboxFriday"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_option_row_selector"
                    android:buttonTint="@color/choice_control_tint"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/day_friday"
                    android:textColor="@color/smart_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/soft_free_time_title"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupFreeTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioNone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:checked="true"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/free_time_none"
                        android:textColor="@color/smart_text_primary" />

                    <RadioButton
                        android:id="@+id/radioMorning"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/free_time_morning"
                        android:textColor="@color/smart_text_primary" />

                    <RadioButton
                        android:id="@+id/radioAfternoon"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_option_row_selector"
                        android:buttonTint="@color/choice_control_tint"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/free_time_afternoon"
                        android:textColor="@color/smart_text_primary" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/checkboxLunch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_option_row_selector"
                    android:buttonTint="@color/choice_control_tint"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/soft_lunch_title"
                    android:textColor="@color/smart_text_primary" />

                <CheckBox
                    android:id="@+id/checkboxAvoidLongGap"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_option_row_selector"
                    android:buttonTint="@color/choice_control_tint"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/soft_gap_title"
                    android:textColor="@color/smart_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/soft_professor_title"
                    android:textColor="@color/smart_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_professors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPreferredProfessors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:hint="@string/hint_professors"
                        android:inputType="text"
                        android:minHeight="52dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/checkboxTravelTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_option_row_selector"
                    android:buttonTint="@color/choice_control_tint"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/soft_travel_title"
                    android:textColor="@color/smart_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_soft"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_reset_soft_constraint"
                    app:cornerRadius="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSkip"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/btn_skip"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRecommend"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/btn_recommend"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
