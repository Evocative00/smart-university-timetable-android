<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/smart_main_screen_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/smart_main_screen_padding"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/smart_back_button_size"
            android:layout_height="@dimen/smart_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_description"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/smart_text_primary" />

        <TextView
            style="@style/Text.SmartTimetable.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/soft_title" />

        <TextView
            style="@style/Text.SmartTimetable.ScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/soft_desc" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soft_free_day_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/soft_free_day_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkboxMonday"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_pill_choice_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/day_monday"
                        android:textColor="@color/smart_choice_text"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/checkboxTuesday"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_pill_choice_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/day_tuesday"
                        android:textColor="@color/smart_choice_text"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/checkboxWednesday"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_pill_choice_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/day_wednesday"
                        android:textColor="@color/smart_choice_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkboxThursday"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_pill_choice_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/day_thursday"
                        android:textColor="@color/smart_choice_text"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/checkboxFriday"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_pill_choice_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/day_friday"
                        android:textColor="@color/smart_choice_text"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/checkboxNoneDay"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_pill_choice_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/day_none"
                        android:textColor="@color/smart_choice_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soft_free_time_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/soft_free_time_desc" />

                <RadioGroup
                    android:id="@+id/radioGroupFreeTime"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_smart_segmented_track"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <RadioButton
                        android:id="@+id/radioNone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_segmented_item_selector"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/free_time_none"
                        android:textStyle="bold"
                        android:textColor="@color/smart_segmented_text"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioMorning"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_segmented_item_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/free_time_morning"
                        android:textStyle="bold"
                        android:textColor="@color/smart_segmented_text"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioAfternoon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_smart_segmented_item_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/free_time_afternoon"
                        android:textStyle="bold"
                        android:textColor="@color/smart_segmented_text"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soft_life_pattern_title" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/soft_life_pattern_desc" />

                <CheckBox
                    android:id="@+id/checkboxLunch"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_smart_soft_row_selector"
                    android:button="@null"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/soft_lunch_title"
                    android:textColor="@color/smart_choice_text"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/checkboxAvoidLongGap"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_smart_soft_row_selector"
                    android:button="@null"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/soft_gap_title"
                    android:textColor="@color/smart_choice_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_soft"
            style="@style/Widget.SmartTimetable.Button.Outline"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="@string/btn_reset_soft_constraint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSkip"
                style="@style/Widget.SmartTimetable.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_skip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecommend"
                style="@style/Widget.SmartTimetable.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/btn_recommend" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
