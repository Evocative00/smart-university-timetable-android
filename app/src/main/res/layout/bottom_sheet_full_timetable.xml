<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_recommendation_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_recommendation_drag_handle" />

    <TextView
        android:id="@+id/tv_full_timetable_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recommendation_full_timetable_title_default"
        android:textColor="@color/smart_text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/recommendation_full_timetable_desc"
        android:textColor="@color/smart_text_secondary"
        android:textSize="13sp" />

    <com.syu.smarttimetable.ui.recommendation.TimetablePreviewView
        android:id="@+id/full_timetable_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />
</LinearLayout>
