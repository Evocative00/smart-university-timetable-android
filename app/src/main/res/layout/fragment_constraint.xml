<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/smart_main_screen_padding"
        android:paddingTop="@dimen/smart_main_top_padding"
        android:paddingEnd="@dimen/smart_main_screen_padding"
        android:paddingBottom="@dimen/smart_main_bottom_padding">

        <TextView
            style="@style/Text.SmartTimetable.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="조건 설정" />

        <TextView
            style="@style/Text.SmartTimetable.ScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="추천에 반영할 조건을 선택하세요." />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="필수 조건" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="학점, 고정 과목, 제외 과목을 설정합니다." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hard_constraint"
                    style="@style/Widget.SmartTimetable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_button_height"
                    android:layout_marginTop="14dp"
                    android:text="필수 조건 설정하기" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선호 조건" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="공강 요일, 시간대, 생활 패턴을 설정합니다." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_soft_constraint"
                    style="@style/Widget.SmartTimetable.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_button_height"
                    android:layout_marginTop="14dp"
                    android:text="선호 조건 설정하기" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
