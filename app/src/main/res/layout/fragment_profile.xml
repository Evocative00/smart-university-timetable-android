<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/smart_main_screen_padding"
        android:paddingTop="@dimen/smart_main_top_padding"
        android:paddingEnd="@dimen/smart_main_screen_padding"
        android:paddingBottom="@dimen/smart_main_bottom_padding">

        <TextView
            style="@style/Text.SmartTimetable.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 정보" />

        <TextView
            style="@style/Text.SmartTimetable.ScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="프로필 사진과 기본 정보를 관리합니다." />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_no_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding_large">

                <TextView
                    style="@style/Text.SmartTimetable.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기본 정보가 없습니다" />

                <TextView
                    style="@style/Text.SmartTimetable.CardBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="아래 버튼을 눌러 기본 정보를 입력해주세요." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_profile"
                    style="@style/Widget.SmartTimetable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_button_height"
                    android:layout_marginTop="18dp"
                    android:text="기본 정보 입력하기" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/smart_surface_card"
            app:cardCornerRadius="@dimen/smart_main_card_radius"
            app:cardElevation="@dimen/smart_main_card_elevation"
            app:strokeColor="@color/smart_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/smart_main_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="86dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_profile_photo"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_smart_avatar_placeholder"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_nav_profile"
                            app:shapeAppearanceOverlay="@style/CircleImageView"
                            app:strokeColor="@color/smart_border"
                            app:strokeWidth="1dp" />

                        <TextView
                            android:id="@+id/tv_change_photo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="4dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="2dp"
                            android:text="사진 변경"
                            android:textColor="@color/smart_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/smart_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_department"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_student_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/smart_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    style="@style/Widget.SmartTimetable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_button_height"
                    android:layout_marginTop="18dp"
                    android:text="정보 수정하기" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    style="@style/Widget.SmartTimetable.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/smart_button_height"
                    android:layout_marginTop="9dp"
                    android:text="로그아웃" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout_no_info"
            style="@style/Widget.SmartTimetable.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/smart_button_height"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:text="로그아웃"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
