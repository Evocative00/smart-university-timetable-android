<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/smart_primary_container" />
            <stroke
                android:width="1dp"
                android:color="@color/smart_primary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/smart_surface_card" />
            <stroke
                android:width="1dp"
                android:color="@color/smart_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
